[Unit]
Description=Auction System (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=auctions
Group=auctions
WorkingDirectory=/opt/auctions/app
EnvironmentFile=/etc/auctions/auctions.env
ExecStart=/opt/auctions/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
