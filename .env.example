# Шаблон настроек. Скопируйте в .env (make setup делает это сам) и задайте
# пароль: make env-password. Файл .env в git и в Docker-образ не попадает.
# Комментарии — только отдельными строками (Makefile читает этот файл).

# ---- Приложение ----
APP_NAME=auction-system
# Версия приложения и тег Docker-образа auctions-app:<APP_VERSION>.
# Обновление образа = новая версия + make container-up.
APP_VERSION=0.1.0
ENVIRONMENT=development
SESSION_TTL_DAYS=7
COOKIE_SECURE=false
BACKUP_FILE=backup.sql

# ---- PostgreSQL (контейнер db) ----
POSTGRES_DB=auction_db
POSTGRES_USER=auction
# Не короче 12 символов, только [A-Za-z0-9_-] (подставляется в URL).
# Стандартные пароли make container-check не пропустит.
POSTGRES_PASSWORD=change-me-please

# ---- Контейнерный стенд (make container-up) ----
# Единственный порт, публикуемый наружу (nginx).
HTTP_PORT=8080
# Имя volume с данными БД (по умолчанию auctions_pgdata).
# DB_VOLUME=auctions_pgdata

# ---- Локальная разработка на хосте (make run / make test) ----
# БД из docker-compose.dev.yml, порт открыт только на 127.0.0.1.
# Пароль должен совпадать с POSTGRES_PASSWORD (make env-password обновит оба).
DATABASE_URL=postgresql+psycopg://auction:change-me-please@localhost:5432/auction_db
TEST_DATABASE_URL=postgresql+psycopg://auction:change-me-please@localhost:5432/auction_test
